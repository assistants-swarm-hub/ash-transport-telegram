{
  "name": "@assistants-swarm-hub/ash-transport-telegram",
  "version": "1.2.0",
  "description": "The Telegram transport for assistants-swarm-hub: a package the core hosts — pollers for each assistant's bot, every update forwarded as the contract's events, the sends performed, and Telegram's own actions as MCP tools.",
  "license": "MIT",
  "keywords": [
    "assistants-swarm-hub",
    "transport",
    "assistants-swarm-hub-transport"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistants-swarm-hub/ash-transport-telegram.git"
  },
  "homepage": "https://github.com/assistants-swarm-hub/ash-transport-telegram#readme",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/types": "^5.0.0",
    "grammy": "^1.46.0"
  },
  "peerDependencies": {
    "@assistants-swarm-hub/transport-sdk": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
